{
  "name": "azure-devops-paired-review",
  "version": "0.7.2",
  "private": true,
  "description": "Local paired-review canvas for Azure DevOps pull requests.",
  "type": "module",
  "scripts": {
    "build": "npm run build:frontend && npm run build:extension && npm run bundle:record",
    "build:extension": "tsdown",
    "build:frontend": "vite build",
    "bundle:record": "node ./scripts/check-bundle-freshness.mjs write",
    "check:bundle": "node ./scripts/check-bundle.mjs && node ./scripts/check-bundle-freshness.mjs check",
    "smoke:bundle": "node ./scripts/smoke-bundle.mjs",
    "typecheck": "tsgo -p tsconfig.json",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.11",
    "@pierre/diffs": "^1.3.2",
    "@sinclair/typebox": "^0.34.41",
    "diff": "^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260418.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.4"
  }
}
