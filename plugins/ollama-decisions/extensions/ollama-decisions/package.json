{
  "name": "ollama-decisions",
  "version": "0.1.6",
  "private": true,
  "description": "Native Copilot tools for installed Ollama decision models.",
  "type": "module",
  "scripts": {
    "build": "tsdown && node ../../../../tools/check-extension-bundles.mjs write plugins/ollama-decisions/extensions/ollama-decisions",
    "test": "node --test --experimental-strip-types --experimental-test-module-mocks tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke:live": "node --experimental-strip-types scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.16",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
