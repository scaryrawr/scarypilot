{
  "name": "copilot-autoresearch",
  "version": "0.3.3",
  "private": true,
  "description": "copilot version of https://github.com/davebcn87/pi-autoresearch",
  "type": "module",
  "scripts": {
    "build": "node native/assemble.mjs --prepare && tsdown && node native/assemble.mjs && node ../../../../tools/check-extension-bundles.mjs write plugins/copilot-autoresearch/extensions/copilot-autoresearch",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "vitest run",
    "native:harness:build": "node native/build-harness.mjs",
    "native:harness:check": "node --test native/tests/build-spec.mjs",
    "native:harness:test": "node --test native/tests/ownership.mjs",
    "native:runtime:test": "node --test native/tests/runtime.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.16",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@typescript/native-preview": "^7.0.0-dev.20260418.1",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.12"
  }
}
