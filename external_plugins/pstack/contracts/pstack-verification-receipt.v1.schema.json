{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scaryrawr/scarypilot/pstack-verification-receipt.v1.schema.json",
  "title": "VerificationReceiptV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "receiptId",
    "pr",
    "sha",
    "verdict",
    "verifier",
    "summary",
    "evidence",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^[a-f0-9]{20}$" },
    "pr": { "type": "integer", "minimum": 1 },
    "sha": { "type": "string", "minLength": 1 },
    "verdict": {
      "enum": [
        "live-ui-verified",
        "unit-test-verified",
        "type-check-only",
        "verifier-blocked",
        "verifier-failed"
      ]
    },
    "verifier": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["file", "command", "link", "note"] },
          "value": { "type": "string", "minLength": 1 },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "supersedesReceiptId": { "type": "string", "pattern": "^[a-f0-9]{20}$" }
  },
  "additionalProperties": false
}
