{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scaryrawr/scarypilot/pstack-snapshot.v1.schema.json",
  "title": "PstackSnapshotV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotHash",
    "capabilities",
    "sources",
    "orch",
    "watch",
    "worktrees",
    "handoff",
    "now",
    "sourceWarnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capabilities": { "type": "object" },
    "sources": { "type": "array" },
    "orch": { "type": ["object", "null"] },
    "watch": { "type": "array" },
    "worktrees": { "type": ["object", "null"] },
    "handoff": { "type": ["object", "null"] },
    "now": { "type": "array" },
    "sourceWarnings": { "type": "array" }
  },
  "additionalProperties": false
}
